<?xml version="1.0"?>
<ruleset name="featured-from-source">
    <description>PSR-12 with a wider line limit.</description>
    <file>src</file>
    <file>tests</file>
    <file>featured-from-source.php</file>
    <file>uninstall.php</file>
    <file>examples</file>
    <exclude-pattern>tests/stubs/*</exclude-pattern>
    <exclude-pattern>vendor/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <rule ref="Generic.Files.LineLength">
        <properties>
            <property name="lineLimit" value="180"/>
            <property name="absoluteLineLimit" value="0"/>
        </properties>
    </rule>

    <!-- The plugin entry points declare and run code by design. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>featured-from-source.php</exclude-pattern>
        <exclude-pattern>uninstall.php</exclude-pattern>
        <exclude-pattern>examples/*</exclude-pattern>
        <exclude-pattern>tests/phpstan-bootstrap.php</exclude-pattern>
    </rule>

    <!-- Test names follow the PRD case numbers (testCase01...). -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
</ruleset>
